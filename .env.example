# ==============================================================================
# 마음결 (Maeumgyeol) 감성 분석 서비스 - 환경변수 예시 파일 (.env.example)
# ==============================================================================
# 이 파일은 참고용 템플릿입니다. 실제 비밀키는 절대 이 파일에 넣지 마시고,
# 복사하여 생성된 `.env.local` 파일에 입력해 주세요.
# ==============================================================================

# [OpenAI API 설정]
# OpenAI 플랫폼(https://platform.openai.com/api-keys)에서 발급받은 API 키를 입력합니다.
OPENAI_API_KEY=replace_with_openai_project_key

# 분석에 사용할 OpenAI 모델 ID (PRD 명세 기준: gpt-5.4-mini-2026-03-17)
OPENAI_MODEL=gpt-5.4-mini-2026-03-17

# [Supabase DB 설정]
# Supabase 프로젝트 대시보드(Project Settings -> API)에서 확인할 수 있는 Project URL입니다.
SUPABASE_URL=https://your-project.supabase.co

# Supabase 서버 전용 비밀키 (Secret / service_role key)
# ※ 주의: 브라우저에 노출되는 anon key가 아니며, 서버 사이드에서만 안전하게 사용됩니다.
SUPABASE_SECRET_KEY=replace_with_supabase_secret_key

